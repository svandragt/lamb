#!/usr/bin/env php
<?php

/**
 * Lamb's operator CLI. Three subcommands:
 *
 *   bin/lamb import <source> <path> [--dry-run] [--replace] [--experimental]
 *   bin/lamb upgrade-posts [--dry-run]
 *   bin/lamb migrate [--dry-run]
 *
 * <source> is one of the registered importers (wordpress, known, lamb — see
 * the registrations below). Each parses its own file format into items, then
 * shares run_import()'s dedupe, progress and summary output.
 *
 * --dry-run     Parse and convert every item but write nothing to the DB
 *               or filesystem. Use this first to surface parsing errors.
 * --replace     Re-apply every already-imported item over its existing post
 *               instead of skipping it. Local edits made since the import
 *               are lost. For re-running an export after a conversion fix.
 * --experimental  Enable the experimental importers for this run.
 *
 * The lamb source also takes --site-url=<url> (see docs/lamb-import.md).
 *
 * upgrade-posts walks every post whose `version` is below POST_VERSION and
 * upgrades it through Response\upgrade_all_posts(), so an archive of stale
 * posts is brought current in one pass instead of stamping the version, one
 * at a time, as each post gets viewed (see docs/upgrade-posts.md).
 *
 * migrate runs the one-time data migrations that used to run implicitly on
 * every boot (backfill_post_version(), backfill_imported_post_identity(),
 * migrate_feed_watermarks()), the one-time migrate_feed_drafts() (#924), the
 * one-time drop_experimental_gate_stamp() for the removed gate's option row,
 * a report of the settings 0.17 removed that the stored settings still hold, plus
 * the same post upgrade as upgrade-posts (#814, reusing
 * Response\upgrade_all_posts() rather than duplicating its
 * batching) — see docs/upgrading.md (#811). The steps live in
 * Bootstrap\migrate_data(), which /_cron also runs when the code changes.
 * `bin/upgrade` runs this command, and /_cron covers an upgrade by a user who
 * does not own lamb.db; restoring an old `lamb.db` backup by hand needs it run
 * explicitly. A run takes the cron lock and records the code it migrated for.
 * It exits 3 when it ran nothing: another user owns lamb.db, or the lock is held.
 *
 * The single entry point for every importer: it owns the bootstrap, argument
 * parsing and source registry the three former import-*.php scripts each
 * hand-rolled a copy of.
 */

namespace Lamb;

use Lamb\Import;
use Lamb\Known;
use Lamb\Restore;
use Lamb\WordPress;
use RedBeanPHP\OODBBean;
use RedBeanPHP\R;
use RuntimeException;

use function Lamb\Response\upgrade_all_posts;

if (PHP_SAPI !== 'cli') {
    fwrite(STDERR, "bin/lamb must be run from the command line.\n");
    exit(1);
}

define('ROOT_DIR', dirname(__DIR__) . '/src');
require dirname(__DIR__) . '/vendor/autoload.php';

Import\register_source([
    'name'        => 'wordpress',
    'parse'       => WordPress\parse_wxr_file(...),
    'extract'     => WordPress\extract_items(...),
    'skip_reason' => WordPress\skip_reason(...),
    'uuid'        => static fn(array $item): string => WordPress\wordpress_uuid((string) $item['guid']),
    'import'      => WordPress\import_item(...),
]);

Import\register_source([
    'name'        => 'known',
    'parse'       => Import\parse_rss_file(...),
    'extract'     => Known\extract_items(...),
    'skip_reason' => Known\skip_reason(...),
    'uuid'        => static fn(array $item): string => Known\known_uuid((string) $item['guid']),
    'import'      => Known\import_item(...),
]);

Import\register_source([
    'name'        => 'lamb',
    'args'        => Restore\parse_restore_args(...),
    'parse'       => static function (string $path): array {
        [, $reader] = Restore\open_source($path);
        return [Restore\read_manifest($reader), $reader];
    },
    'extract'     => static function (array $parsed, ?string $site_url = null): array {
        [$manifest, $reader] = $parsed;
        $origin = Restore\origin_id($manifest, $site_url);
        if ($origin === '') {
            fwrite(STDERR, "Warning: this archive names no site URL, so imported ids are namespaced by an empty origin. Pass --site-url=<url> to keep two sites' posts apart.\n");
        }
        return Restore\manifest_items($manifest, $reader, $origin);
    },
    'skip_reason' => Restore\item_skip_reason(...),
    'uuid'        => static fn(array $item): string => (string) $item['import_uuid'],
    'import'      => Restore\import_post(...),
    'after'       => static function (array $parsed, bool $dry_run): void {
        [$manifest, $reader] = $parsed;
        $assets = Restore\restore_assets($manifest, ROOT_DIR . '/assets', $reader, $dry_run);
        echo "Assets: restored={$assets['restored']} skipped={$assets['skipped']} rejected={$assets['rejected']}\n";
    },
]);

/**
 * Resolves the data directory, refuses a database owned by another user, and
 * opens it.
 *
 * Every bin/lamb path that touches the database goes through here on purpose.
 * The #831 ownership check only protects the call it sits in front of, so a
 * command calling bootstrap_db() itself would open the database unguarded and
 * leave exactly the WAL sidecars that check exists to prevent.
 *
 * @param int $refusal_exit_code Exit code when the ownership guard refuses.
 *                               Every command but `migrate` keeps the
 *                               original 1 ("something failed"); `migrate`
 *                               passes 3 so `bin/upgrade` can tell "refused,
 *                               never touched the database" apart from "ran
 *                               and a migration genuinely failed" (#811).
 * @param string $example Command shown in the "run as the web server user"
 *                         hint, so it matches whichever command refused.
 * @return string Absolute path to the data directory.
 */
function open_data_dir(int $refusal_exit_code = 1, string $example = 'import ...'): string
{
    $data_dir = Bootstrap\data_dir(dirname(__DIR__));

    // #831: WAL mode (#780) leaves lamb.db-wal/-shm sidecars owned by whoever
    // opens the database. A read-only connection can never checkpoint them away,
    // so once lamb.db and its invoker's uid disagree, every later web request
    // dies in ensure_schema() with "attempt to write a readonly database" until
    // someone removes the sidecars by hand. Refuse before bootstrap_db() opens
    // the database, so this process never creates one of those sidecars itself.
    //
    // posix_geteuid() is unavailable when the posix extension isn't built in.
    // When the uid can't be determined we proceed rather than block a legitimate
    // run: an unnecessary refusal costs someone their import, a missed one costs
    // them a 500 they can recover from by deleting two files.
    $current_uid = function_exists('posix_geteuid') ? posix_geteuid() : null;

    if (Bootstrap\db_owned_by_another_user("$data_dir/lamb.db", $current_uid)) {
        fwrite(STDERR, "bin/lamb: $data_dir/lamb.db is owned by a different user than the one running this command.\n");
        fwrite(STDERR, "A read-only connection can't checkpoint away the WAL sidecar files it would leave behind, and every later web request would then fail with \"attempt to write a readonly database\" until someone removes them by hand.\n");
        fwrite(STDERR, "Run bin/lamb as the web server user instead, for example:\n");
        fwrite(STDERR, "    sudo -u www-data bin/lamb $example\n");
        exit($refusal_exit_code);
    }

    Bootstrap\bootstrap_db($data_dir);

    return $data_dir;
}

$command = $argv[1] ?? null;

if ($command === 'upgrade-posts') {
    $rest = array_slice($argv, 2);
    $dry_run = in_array('--dry-run', $rest, true);
    if (array_diff($rest, ['--dry-run']) !== []) {
        fwrite(STDERR, "Usage: bin/lamb upgrade-posts [--dry-run]\n");
        exit(1);
    }

    $data_dir = open_data_dir(example: 'upgrade-posts');

    global $config;
    $config = Config\load();
    Config\apply_timezone($config);

    [$needing, $upgraded] = upgrade_all_posts($dry_run);
    $prefix = $dry_run ? '[dry-run] ' : '';
    echo "{$prefix}Done. needs_upgrade=$needing upgraded=$upgraded\n";
    exit(0);
}

if ($command === 'migrate') {
    $rest = array_slice($argv, 2);
    $dry_run = in_array('--dry-run', $rest, true);
    if (array_diff($rest, ['--dry-run']) !== []) {
        fwrite(STDERR, "Usage: bin/lamb migrate [--dry-run]\n");
        exit(1);
    }

    // Refuses with exit 3, not the usual 1, when the #831 ownership guard
    // fires: bin/upgrade runs this automatically, and it must be able to
    // tell "never touched the database" apart from "a migration genuinely
    // failed" so it can warn and finish the upgrade instead of failing it.
    $data_dir = open_data_dir(refusal_exit_code: 3, example: 'migrate');

    global $config;
    $config = Config\load();
    Config\apply_timezone($config);

    $prefix = $dry_run ? '[dry-run] ' : '';

    // The cron lock serialises this run with /_cron, which runs the same
    // migrations once the code changes. A dry run writes nothing, so it takes
    // no lock. Exit 3 again: nothing ran here, and the site's next /_cron
    // request will migrate.
    $lock_path = Network\cron_lock_path($data_dir);
    $lock_is_new = !file_exists($lock_path);
    $lock = $dry_run ? null : Network\acquire_cron_lock($lock_path);
    if ($lock === false) {
        fwrite(STDERR, "bin/lamb: cannot open the lock file at $lock_path. Is the data directory writable?\n");
        exit(1);
    }
    if ($lock_is_new && is_resource($lock)) {
        Network\align_lock_file_with_database($lock_path, "$data_dir/lamb.db");
    }
    if ($lock === null && !$dry_run) {
        fwrite(STDERR, "bin/lamb: /_cron or another bin/lamb migrate holds the lock, so no migration ran. Run bin/lamb migrate again when it has finished.\n");
        exit(3);
    }

    // Before the steps, as /_cron does: the marker names the code that ran them.
    $marker = Bootstrap\code_marker();
    $migrated_for = get_option(Bootstrap\DATA_MIGRATED_FOR_OPTION, '');
    $already_current = (string) $migrated_for->value === $marker;
    foreach (Bootstrap\migrate_data($dry_run) as $line) {
        echo $line . "\n";
    }

    // Report only: the settings page is the one place that drops a removed setting.
    $stored_ini = Config\get_ini_text();
    if (!Config\validate_ini($stored_ini)['valid']) {
        echo "{$prefix}check_removed_settings: the stored settings do not parse, so removed settings could not be checked\n";
    }
    foreach (Config\removed_settings_in_use($stored_ini) as $setting => $replacement) {
        echo "{$prefix}check_removed_settings: `$setting` was removed and is ignored; saving the settings page drops it. Replacement: $replacement\n";
    }

    // A manual run counts for the code it ran with, so /_cron does not repeat it. The result
    // line is the one /_cron prints, and bin/upgrade reads it to decide whether a rollback is safe.
    if (!$dry_run) {
        set_option($migrated_for, $marker);
        echo Bootstrap\data_migration_result_line($already_current ? 'already current' : 'migrated') . "\n";
    }

    echo "{$prefix}Done.\n";
    exit(0);
}

if ($command !== 'import') {
    fwrite(STDERR, "Usage: bin/lamb import <source> <path> [--dry-run] [--replace] [--experimental]\n");
    fwrite(STDERR, "       bin/lamb upgrade-posts [--dry-run]\n");
    fwrite(STDERR, "       bin/lamb migrate [--dry-run]\n");
    fwrite(STDERR, 'Sources: ' . implode(', ', Import\source_names()) . "\n");
    exit(1);
}

$name = $argv[2] ?? null;
$source = $name !== null ? Import\get_source($name) : null;
if ($source === null) {
    fwrite(STDERR, 'Unknown import source' . ($name !== null ? ": $name" : '') . ".\n");
    fwrite(STDERR, 'Valid sources: ' . implode(', ', Import\source_names()) . "\n");
    exit(1);
}

// [$name, <path and flags>...] — the shape parse_import_args() expects of a
// normal $argv, where index 0 is a script name it ignores.
$rest = array_slice($argv, 2);
$experimental = in_array('--experimental', $rest, true);
$rest = array_values(array_diff($rest, ['--experimental']));
$args_fn = $source['args'] ?? static fn(array $argv): array => Import\parse_import_args($argv);
$parsed_args = $args_fn($rest);
[$path, $dry_run, $replace] = $parsed_args;
$extra = array_slice($parsed_args, 3);

if ($path === null) {
    fwrite(STDERR, "Usage: bin/lamb import {$source['name']} <path> [--dry-run] [--replace] [--experimental]\n");
    exit(1);
}

// Before open_data_dir(): a refused import must not create or open the database.
if (!$experimental) {
    fwrite(STDERR, "The {$source['name']} importer is experimental. Enable it first: pass --experimental.\n");
    exit(1);
}

$data_dir = open_data_dir();

global $config;
$config = Config\load();
Config\apply_timezone($config);

try {
    $parsed = ($source['parse'])($path);
} catch (RuntimeException $e) {
    fwrite(STDERR, $e->getMessage() . "\n");
    exit(1);
}

$items = ($source['extract'])($parsed, ...$extra);

Import\run_import(
    $items,
    $source['skip_reason'],
    $source['uuid'],
    $source['import'],
    $dry_run,
    static fn(string $uuid): ?OODBBean => R::findOne('post', ' import_uuid = ? ', [$uuid]),
    $replace,
);

if (isset($source['after'])) {
    ($source['after'])($parsed, $dry_run);
}
