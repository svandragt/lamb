<?xml version="1.0"?>
<ruleset name="Lamb standard">
    <description>PHP Coding Standards for Lamb</description>

    <!-- Minimum supported PHP (matches composer.json require); keep at the floor, not the default. -->
    <config name="php_version" value="80400"/>

    <!-- Set the PHP version range for PHPCompatibility (matches composer.json require). -->
    <config name="testVersion" value="8.4-8.6"/>

    <!-- Show sniff codes in all reports. -->
    <arg value="s"/>

    <!-- Check PHP files only. -->
    <arg name="extensions" value="php"/>

    <!-- Exclude hidden directories (relative, so a checkout under a dotted
         path such as a .claude/worktrees/ worktree doesn't exclude everything) -->
    <exclude-pattern type="relative">^\.</exclude-pattern>
    <exclude-pattern>vendor/</exclude-pattern>
    <exclude-pattern>node_modules/</exclude-pattern>

    <!-- Check for PHP cross-version compatibility. -->
    <rule ref="PHPCompatibility">
        <!-- PHP 8.6's trim() default only adds \f, which is harmless for the text Lamb trims, and the sniff flags every trim() call. -->
        <exclude name="PHPCompatibility.ParameterValues.NewTrimCharactersDefault"/>
    </rule>
    <rule ref="PSR2">
        <!-- tests/-->
        <exclude name="PSR2.Methods.MethodDeclaration.Underscore"/>
        <exclude name="PSR2.Namespaces.UseDeclaration.SpaceAfterUse"/>
    </rule>
    <rule ref="PSR12">
        <!-- Disable specific rules I don't like -->
        <exclude name="Generic.Files.LineLength.TooLong"/>
        <exclude name="PSR1.Files.SideEffects.FoundWithSymbols"/>
    </rule>
</ruleset>
